# NHARC website — Caddy config.
# Installed on the server at /etc/caddy/Caddyfile.
# Caddy obtains and renews Let's Encrypt certificates automatically.

# Primary site: nharc.org (canonical). newweb.nharc.org is kept as a preview host
# and is where the CMS OAuth relay currently lives.
nharc.org, newweb.nharc.org {
	root * /var/www/nharc
	encode zstd gzip

	# Baseline security response headers.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# CMS "Sign In with GitHub" OAuth relay (nharc-oauth.service on :8402).
	handle /auth* {
		reverse_proxy 127.0.0.1:8402
	}
	handle /callback* {
		reverse_proxy 127.0.0.1:8402
	}

	# Static site.
	handle {
		# Long-cache the immutable hashed assets Astro emits under /_astro/.
		@astro path /_astro/*
		header @astro Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Friendly 404 page.
	handle_errors {
		@notfound expression {http.error.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}
}

# Send the alternate hostnames (www, and the .com domain) to the canonical apex.
www.nharc.org, nharc.com, www.nharc.com {
	redir https://nharc.org{uri} permanent
}

# Access + runtime logs go to journald: `journalctl -u caddy`.
