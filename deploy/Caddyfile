# NHARC website — Caddy config.
# Installed on the server at /etc/caddy/Caddyfile.
# Caddy obtains and renews Let's Encrypt certificates automatically.

# Primary site: nharc.org (canonical). newweb.nharc.org is kept as a preview host
# and is where the CMS OAuth relay currently lives.
nharc.org, newweb.nharc.org {
	root * /var/www/nharc
	encode zstd gzip

	# Baseline security response headers.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# CMS "Sign In with GitHub" OAuth relay (nharc-oauth.service on :8402).
	handle /auth* {
		reverse_proxy 127.0.0.1:8402
	}
	handle /callback* {
		reverse_proxy 127.0.0.1:8402
	}

	# Structured access log, consumed nightly by GoAccess (see deploy/stats/).
	# Caddy rolls and gzips these itself — no logrotate needed.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 12
			roll_keep_for 2160h
		}
		format json
	}

	# Private traffic report. GoAccess writes /var/www/nharc-stats/index.html
	# nightly; credentials live in /etc/caddy/stats-auth.conf, which is NOT in
	# this repo (it's public) and must exist or Caddy will refuse to start.
	handle_path /stats* {
		import /etc/caddy/stats-auth.conf
		root * /var/www/nharc-stats
		file_server
		# Keep our own report views out of the numbers they report on.
		log_skip
	}

	# Static site.
	handle {
		# Long-cache the immutable hashed assets Astro emits under /_astro/.
		@astro path /_astro/*
		header @astro Cache-Control "public, max-age=31536000, immutable"

		# Serve the news feed as a feed. By extension alone Caddy would call it
		# text/xml, which readers tolerate but which isn't the registered type.
		@feed path /rss.xml
		header @feed Content-Type "application/rss+xml; charset=utf-8"

		file_server
	}

	# Friendly 404 page.
	handle_errors {
		@notfound expression {http.error.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}
}

# Send the alternate hostnames (www, and the .com domain) to the canonical apex.
www.nharc.org, nharc.com, www.nharc.com {
	redir https://nharc.org{uri} permanent
}

# Runtime/error logs go to journald: `journalctl -u caddy`.
# Access logs are the JSON file above: /var/log/caddy/access.log.
