---
// Small green line-icons for cards. Stroke inherits currentColor (set to green
// via .card-icon). Geometry is Feather-style (24x24, round joins).
interface Props { name: string; size?: number; }
const { name, size = 30 } = Astro.props;

const icons: Record<string, string> = {
  // broadcasting antenna — repeaters
  repeaters: '<circle cx="12" cy="12" r="2"/><path d="M7.8 16.2a6 6 0 0 1 0-8.4M16.2 7.8a6 6 0 0 1 0 8.4M5.1 19a10 10 0 0 1 0-14M18.9 5a10 10 0 0 1 0 14"/>',
  // microphone — voice nets
  nets: '<rect x="9" y="2" width="6" height="11" rx="3"/><path d="M5 10v1a7 7 0 0 0 14 0v-1M12 18v3M8 21h8"/>',
  // clipboard with check — VE testing
  testing: '<path d="M9 3h6v3H9z"/><path d="M15 4h2a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M9 14l2 2 4-4"/>',
  // clipboard list — business meeting
  business: '<path d="M9 3h6v3H9z"/><path d="M15 4h2a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M9 12h6M9 16h6"/>',
  // people — activities meeting / fellowship
  activities: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  // file with lines — meeting minutes
  minutes: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h8"/>',
  // screen with chart — presentations
  presentations: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4M7 12.5l3-3 2 2 4-4"/>',
};
const inner = icons[name] ?? '';
---
<svg
  class="card-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
></svg>
