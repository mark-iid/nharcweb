---
// Small auto-crossfading photo strip of club life. Pure CSS — each slide fades
// in on a staggered delay across one shared cycle. Freezes on the first image
// when the visitor prefers reduced motion.
const slides = [
  { src: '/images/club/club-1.webp', alt: 'A young operator works HF at a club field event' },
  { src: '/images/club/club-2.webp', alt: 'Members work amateur satellites with a handheld beam antenna' },
  { src: '/images/club/club-3.webp', alt: 'A member on the air at a fall outing' },
  { src: '/images/club/club-4.webp', alt: 'Club members at the annual holiday dinner' },
  { src: '/images/club/club-5.webp', alt: 'Members at a club meeting' },
  { src: '/images/club/club-6.webp', alt: 'Setting up radio gear at a park pavilion' },
];
---
<div class="club-slideshow" role="group" aria-label="Photos from around the club">
  {slides.map((s, i) => (
    <img
      class="club-slide"
      src={s.src}
      alt={s.alt}
      width="1000"
      height="563"
      loading="lazy"
      decoding="async"
      style={`--i:${i}`}
    />
  ))}
</div>

<style>
  .club-slideshow {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow);
    background: var(--bg-band);
  }
  .club-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    will-change: opacity;
    animation: clubFade 36s linear infinite;
    animation-delay: calc(var(--i) * 6s);
  }
  /* Each of the 6 slides is fully shown for ~5s of the 36s cycle, with a ~0.6s crossfade. */
  @keyframes clubFade {
    0%   { opacity: 0; }
    1.6% { opacity: 1; }
    15%  { opacity: 1; }
    18%  { opacity: 0; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .club-slide { animation: none; }
    .club-slide:first-child { opacity: 1; }
  }
</style>
