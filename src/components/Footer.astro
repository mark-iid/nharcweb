---
import site from '../data/site.json';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <svg class="footer-hills" viewBox="0 0 1440 56" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,40 C300,6 560,54 820,36 C1080,18 1240,52 1440,28 L1440,56 L0,56 Z" fill="#006633" />
  </svg>
  <div class="wrap footer-grid">
    <div>
      <h4>{site.clubName}</h4>
      <p>
        {site.mailingAddress.line1}<br />
        {site.mailingAddress.city}, {site.mailingAddress.state} {site.mailingAddress.zip}
      </p>
      <p>
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        <a href={site.facebook} rel="noopener">Facebook — @nharc.w3exw</a>
      </p>
      <a class="arrl-badge" href="https://www.arrl.org/" target="_blank" rel="noopener"
        title="ARRL Affiliated Club — visit ARRL.org">
        <img src="/images/arrl-affiliated.png" width="92" height="92" alt="ARRL Affiliated Club" loading="lazy" />
      </a>
    </div>
    <div>
      <h4>Explore</h4>
      <ul>
        <li><a href="/news">News</a></li>
        <li><a href="/about">About the Club</a></li>
        <li><a href="/repeaters">Repeaters</a></li>
        <li><a href="/nets">Nets &amp; Schedule</a></li>
        <li><a href="/dstar">D-STAR</a></li>
      </ul>
    </div>
    <div>
      <h4>Get Involved</h4>
      <ul>
        <li><a href="/meetings">Meetings</a></li>
        <li><a href="/calendar">Calendar</a></li>
        <li><a href="/minutes">Meeting Minutes</a></li>
        <li><a href="/presentations">Presentations</a></li>
        <li><a href="/ve-testing">License Testing</a></li>
        <li><a href="/membership">Join / Renew</a></li>
        <li><a href="/raffle">Club Raffle</a></li>
        <li><a href="/contact">Contact Us</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>&copy; {year} {site.clubName} &middot; <span class="callsign">{site.callsign}</span></span>
    <span>Greater Pittsburgh, Pennsylvania</span>
  </div>
</footer>
