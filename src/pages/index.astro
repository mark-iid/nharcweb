---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ClubSlideshow from '../components/ClubSlideshow.astro';
import site from '../data/site.json';
import home from '../data/home.json';
import netData from '../data/nets.json';
const nets = netData.nets;

const latestNews = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => {
    if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
    return b.data.date.getTime() - a.data.date.getTime();
  })
  .slice(0, 3);

// Featured, still-upcoming events for the homepage banner ("today" is build time;
// a daily scheduled rebuild keeps it current so past events drop off on their own).
const now = new Date();
const today = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
const dayOf = (d: Date) => new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()));
const featuredEvents = (await getCollection('events', ({ data }) => data.featured && !data.draft))
  .filter((e) => dayOf(e.data.endDate ?? e.data.date) >= today)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 2);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const evWhen = (d: Date) => {
  const base = d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC' });
  const timed = d.getUTCHours() !== 0 || d.getUTCMinutes() !== 0;
  return timed ? `${base} · ${d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'UTC' })}` : base;
};
const evMon = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });
const evDay = (d: Date) => d.toLocaleDateString('en-US', { day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">{site.callsign} &middot; Greater Pittsburgh</p>
        <h1>North Hills Amateur Radio Club</h1>
        <p class="lede">{home.heroLede}</p>
        <div class="btn-row">
          <a class="btn" href="/membership">Join the Club</a>
          <a class="btn secondary" href="/meetings">Meeting Schedule</a>
          <a class="btn secondary" href="/repeaters">Our Repeaters</a>
        </div>
      </div>
      <div class="hero-art">
        <div class="hero-seal">
          <img src="/images/nharc-seal.png" width="300" height="296" alt="North Hills Amateur Radio Club seal — W3EXW" />
        </div>
      </div>
    </div>
    <svg class="hero-hills" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,64 C220,18 380,110 640,64 C900,18 1120,100 1440,50 L1440,120 L0,120 Z" fill="#009933" opacity=".92" />
      <path d="M0,88 C260,50 520,112 780,86 C1040,60 1240,112 1440,82 L1440,120 L0,120 Z" fill="var(--bg)" />
    </svg>
  </section>

  {/* Featured upcoming events — set "Feature on the homepage" on an event in the CMS */}
  {featuredEvents.length > 0 && (
    <div class="wrap" style="margin-top: 2rem;">
      {featuredEvents.map((ev) => (
        <div class="callout info" style="display: flex; gap: 0.9rem 1.2rem; align-items: center; flex-wrap: wrap;">
          <div class="event-badge"><span class="mon">{evMon(ev.data.date)}</span><span class="day">{evDay(ev.data.date)}</span></div>
          <div style="flex: 1 1 16rem;">
            <h3 style="margin: 0 0 0.2rem;">{ev.data.title}</h3>
            <p style="margin: 0; color: var(--muted);">{evWhen(ev.data.date)}{ev.data.location && <> &middot; {ev.data.location}</>}</p>
          </div>
          <a class="btn ghost" href="/calendar">Details →</a>
        </div>
      ))}
    </div>
  )}

  {/* What the club offers */}
  <div class="wrap">
    <div class="grid cols-3" style="margin: 2.4rem 0;">
      <div class="card">
        <Icon name="repeaters" />
        <h3>Repeaters</h3>
        <p>A robust network of 2 m, 1.25 m, and 70 cm machines — analog and D-STAR — covering the region 24/7.</p>
        <p><a href="/repeaters">See frequencies &amp; tones →</a></p>
      </div>
      <div class="card">
        <Icon name="nets" />
        <h3>Weekly Nets</h3>
        <p>Check in with the club on the air. Our voice net runs every Tuesday and the D-STAR net every Monday.</p>
        <p><a href="/nets">Net schedule →</a></p>
      </div>
      <div class="card">
        <Icon name="testing" />
        <h3>License Testing</h3>
        <p>VE exam sessions on the second Saturday of each month for new and upgrading hams.</p>
        <p><a href="/ve-testing">Testing details →</a></p>
      </div>
    </div>
  </div>

  {/* Community */}
  <div class="wrap" style="margin: 0.6rem auto 2.8rem;">
    <div class="grid cols-2" style="align-items: center;">
      <ClubSlideshow />
      <div>
        <h2 style="margin-top: 0;">Around the club</h2>
        <p>{home.aroundBlurb}</p>
        <p style="margin-bottom: 0;"><a class="btn ghost" href="/meetings">Get involved</a></p>
      </div>
    </div>
  </div>

  {/* What's new — announcements up high */}
  {latestNews.length > 0 && (
    <div class="wrap" style="margin: 2.6rem auto;">
      <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
        <h2 style="margin: 0;">Latest News</h2>
        <a href="/news">All news →</a>
      </div>
      <div style="margin-top: 1rem;">
        {latestNews.map((post) => (
          <article class="card" style="margin-bottom: 0.9rem;">
            <span class="pill">{fmtDate(post.data.date)}</span>
            {post.data.pinned && <span class="pill" style="margin-left: 0.4rem;">📌 Pinned</span>}
            <h3 style="margin: 0.45rem 0 0.3rem;">
              <a href={`/news/${post.id}`}>{post.data.title}</a>
            </h3>
            {post.data.summary && <p style="margin-bottom: 0;">{post.data.summary}</p>}
          </article>
        ))}
      </div>
    </div>
  )}

  {/* Practical: when & where */}
  <div class="section-soft">
    <div class="wrap section-soft-inner">
      <div class="grid cols-2">
        <div>
          <h2 style="margin-top:0;">Meetings</h2>
          <p><strong>Business meeting</strong> — {site.meetings.business}</p>
          <p><strong>Activities meeting</strong> — {site.meetings.activities}</p>
          <p>
            In-person meetings are held at <strong>{site.meetingVenue.name}</strong>,
            {site.meetingVenue.address}. {site.meetingVenue.parking}
          </p>
          <p><a class="btn ghost" href="/meetings">More about meetings</a></p>
        </div>
        <div>
          <h2 style="margin-top:0;">On the Air This Week</h2>
          {nets.map((net) => (
            <p>
              <strong>{net.name}</strong> — {net.day} at {net.time}<br />
              <span class="callsign">{net.repeater}</span>
            </p>
          ))}
          <p><a class="btn ghost" href="/nets">Full net schedule</a></p>
        </div>
      </div>
    </div>
  </div>

  {/* Lighter callouts — raffle can be switched off in the CMS when it's over */}
  {home.raffle.enabled && (
    <div class="wrap" style="margin: 2.4rem auto 0;">
      <div class="callout" style="display: flex; gap: 1rem 1.2rem; align-items: center; flex-wrap: wrap;">
        <span class="icon" style="font-size: 2rem; line-height: 1;">🎟️</span>
        <div style="flex: 1 1 18rem;">
          <h3 style="margin: 0 0 0.3rem;">{home.raffle.heading}</h3>
          <p style="margin: 0;">{home.raffle.text}</p>
        </div>
        <a class="btn" href={home.raffle.buttonHref}>{home.raffle.buttonLabel}</a>
      </div>
    </div>
  )}

  <div class="wrap" style={`margin: ${home.raffle.enabled ? '1.1rem' : '2.4rem'} auto 0;`}>
    <div class="callout">
      <p>
        <strong>☕ Club breakfast.</strong> {site.breakfast} Come hang out — all are welcome, no reservation needed.
      </p>
    </div>
  </div>
</BaseLayout>
