---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
  return b.data.date.getTime() - a.data.date.getTime();
});
// Render each post's full body so the News page reads top-to-bottom — one click,
// no click-through. Each post still has its own URL (the linked headline) for sharing.
const rendered = await Promise.all(
  posts.map(async (post) => ({ post, Content: (await render(post)).Content }))
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title="News" description="News and announcements from the North Hills Amateur Radio Club.">
  <PageHeader title="News" sub="Announcements and updates from the club." />
  <div class="wrap">
    {posts.length === 0 && <p>No news yet — check back soon.</p>}
    {rendered.map(({ post, Content }) => (
      <article class="prose news-item">
        <span class="pill">{fmt(post.data.date)}</span>
        {post.data.pinned && <span class="pill" style="margin-left: 0.4rem;">📌 Pinned</span>}
        <h2 style="margin: 0.5rem 0 0.7rem;">
          <a href={`/news/${post.id}`}>{post.data.title}</a>
        </h2>
        <Content />
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .news-item {
    max-width: 46rem;
    margin: 0 0 2.4rem;
    padding-bottom: 1.6rem;
    border-bottom: 1px solid var(--line);
  }
  .news-item:last-child { border-bottom: 0; }
</style>
