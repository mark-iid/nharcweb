---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
---
<BaseLayout title="Meetings" description="NHARC meeting schedule and location.">
  <PageHeader title="Meetings" sub="Two meetings a month, plus an informal breakfast — come get to know the club." />
  <div class="wrap">
    <div class="grid cols-2">
      <div class="card">
        <Icon name="business" />
        <h3>Business Meeting</h3>
        <p>{site.meetings.business}</p>
      </div>
      <div class="card">
        <Icon name="activities" />
        <h3>Activities Meeting</h3>
        <p>{site.meetings.activities}</p>
      </div>
    </div>

    <div class="callout info" style="margin-top: 1.2rem;">
      <p style="margin: 0;">
        <strong>Not a member? Come anyway!</strong> You don't have to be a member to attend a
        meeting — visitors and prospective hams are always welcome. It's a great way to meet the
        club and see what amateur radio is all about.
      </p>
    </div>

    <h2>Where we meet</h2>
    <p>
      In-person meetings are held at <strong>{site.meetingVenue.name}</strong> —
      {site.meetingVenue.address}. {site.meetingVenue.parking}
    </p>
    <p>
      Business meetings are currently held virtually via <strong>Zoom</strong>. For the meeting
      link or the current schedule, email <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>

    <div class="callout">
      <p><strong>☕ Club breakfast.</strong> {site.breakfast}</p>
    </div>

    <h2>From our meetings</h2>
    <div class="grid cols-2">
      <div class="card">
        <Icon name="minutes" />
        <h3>Meeting Minutes</h3>
        <p>Minutes from our monthly business and activities meetings.</p>
        <p style="margin-bottom: 0;"><a href="/minutes">Read the minutes →</a></p>
      </div>
      <div class="card">
        <Icon name="presentations" />
        <h3>Presentations</h3>
        <p>Slide decks from the programs and talks at our activities meetings.</p>
        <p style="margin-bottom: 0;"><a href="/presentations">Browse presentations →</a></p>
      </div>
    </div>
  </div>
</BaseLayout>
